# ==============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# Copy this file to .env in root or into respective backend/.env and frontend/.env
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (backend/.env)
# ------------------------------------------------------------------------------
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# Security Keys (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=replace-with-a-random-flask-secret-key-32-chars
JWT_SECRET_KEY=replace-with-a-random-jwt-secret-key-32-chars
JWT_EXPIRATION_DAYS=7

# Supabase PostgreSQL Database Connection
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Or direct: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your-db-password@db.your-supabase-id.supabase.co:5432/postgres

# Google OAuth 2.0 (From Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Gmail SMTP Notification Credentials (App Password)
# Note: Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_DEFAULT_SENDER="Hairdrama Tech Tasks <your-email@gmail.com>"

# Backward-compatibility aliases
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# Client Application URL (For CORS and email notification task links)
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (frontend/.env.local)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
